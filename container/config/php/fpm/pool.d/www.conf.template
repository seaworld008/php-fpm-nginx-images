[www]
; Pool user and group
user = nginx
group = nginx

; Listen on Unix socket (more secure and performant than TCP)
listen = /run/php/php7.2-fpm.sock
listen.owner = nginx
listen.group = nginx
listen.mode = 0660
listen.backlog = 1024

; Process manager settings
pm = dynamic
pm.max_children = ${PHP_FPM_MAX_CHILDREN:-12}
pm.start_servers = ${PHP_FPM_START_SERVERS:-4}
pm.min_spare_servers = ${PHP_FPM_MIN_SPARE_SERVERS:-4}
pm.max_spare_servers = ${PHP_FPM_MAX_SPARE_SERVERS:-8}
pm.max_requests = ${PHP_FPM_MAX_REQUESTS:-800}

; Status and ping endpoints (accessed via Nginx loopback)
pm.status_path = /fpm_status
ping.path = /fpm_ping
ping.response = pong

; Security
security.limit_extensions = .php

; Logging
catch_workers_output = yes
decorate_workers_output = no

; Environment handling
clear_env = yes
; Whitelist required environment variables
env[PATH] = /usr/local/bin:/usr/bin:/bin
env[TMP] = /tmp
env[TMPDIR] = /tmp
env[TEMP] = /tmp

; Timeouts and slowlog
request_terminate_timeout = ${PHP_REQUEST_TERMINATE_TIMEOUT:-65s}
request_slowlog_timeout = ${PHP_REQUEST_SLOWLOG_TIMEOUT:-5s}
slowlog = /proc/self/fd/2

; PHP admin values (cannot be overridden)
php_admin_flag[display_errors] = off
php_admin_flag[display_startup_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /proc/self/fd/2
php_admin_value[memory_limit] = ${PHP_MEMORY_LIMIT:-256M}

; Session upload progress (CVE-2026-109619 mitigation)
php_admin_flag[session.upload_progress.enabled] = ${PHP_SESSION_UPLOAD_PROGRESS:-off}

; Additional PHP settings
php_value[max_execution_time] = ${PHP_MAX_EXECUTION_TIME:-60}
php_value[upload_max_filesize] = ${PHP_UPLOAD_MAX_FILESIZE:-100M}
php_value[post_max_size] = ${PHP_POST_MAX_SIZE:-105M}
php_value[date.timezone] = ${TZ:-Asia/Shanghai}
